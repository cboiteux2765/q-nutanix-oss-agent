{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "repo": {
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "title": "Repo",
      "type": "string"
    },
    "pr_number": {
      "exclusiveMinimum": 0,
      "title": "Pr Number",
      "type": "integer"
    },
    "spec_id": {
      "title": "Spec Id",
      "type": "string"
    },
    "spec_uri": {
      "title": "Spec Uri",
      "type": "string"
    },
    "spec_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Spec Hash",
      "type": "string"
    },
    "test_profile_id": {
      "title": "Test Profile Id",
      "type": "string"
    },
    "environment_manifest_id": {
      "title": "Environment Manifest Id",
      "type": "string"
    },
    "max_debug_iterations": {
      "default": 2,
      "maximum": 2,
      "minimum": 0,
      "title": "Max Debug Iterations",
      "type": "integer"
    },
    "max_test_executions": {
      "default": 4,
      "maximum": 4,
      "minimum": 1,
      "title": "Max Test Executions",
      "type": "integer"
    },
    "max_runtime_seconds": {
      "default": 1200,
      "maximum": 1200,
      "minimum": 1,
      "title": "Max Runtime Seconds",
      "type": "integer"
    },
    "max_llm_cost_usd": {
      "default": 2.0,
      "maximum": 2.0,
      "minimum": 0,
      "title": "Max Llm Cost Usd",
      "type": "number"
    },
    "correlation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Run Id"
    }
  },
  "required": [
    "repo",
    "pr_number",
    "spec_id",
    "spec_uri",
    "spec_hash",
    "test_profile_id",
    "environment_manifest_id",
    "correlation_id"
  ],
  "title": "CreateRunRequest",
  "type": "object"
}