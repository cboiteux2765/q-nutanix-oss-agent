# Only needed when the provider requires authentication.
OPENAI_API_KEY=

# Optional overrides for provider settings.
# EVO_MODEL=gpt-6.1-terra
# EVO_BASE_URL=https://api.openai.com/v1
# EVO_API_STYLE=responses
# EVO_DATA_DIR=.evo
# Repository opened when no project exists yet (default: this checkout; empty = ask).
# EVO_DEFAULT_REPO=

# Evolution experiments: the pytest replay mirror (history.db + repo.git) and a Python
# with pytest's dependencies. Defaults: D:/capstone/data/pytest and D:/evo-demos/pytest-env.
# EVO_REPLAY_DATA=...
# EVO_REPLAY_PYTHON=...

# UCSB AI Commons (OpenAI-compatible) for the Product Spec Agent harnesses and evals.
# Create the key in AI Commons -> Settings -> API Keys (requires the `openai` group);
# the same page shows the base URL, ending in /v1. Usage counts against a monthly token cap.
# AICOMMONS_API_KEY=
# AICOMMONS_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com/v1
